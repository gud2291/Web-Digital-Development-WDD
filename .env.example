# ===========================================================================
# 🔒 WDD Website — Environment Variables (TEMPLATE)
# ===========================================================================
# Copy this file to `.env.local` (gitignored) and fill the values.
# All required variables are validated at boot time by src/config/env.ts.
# See SETUP.md for step-by-step instructions to obtain each value.
# ===========================================================================

# ─── App ───────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Database (MongoDB Atlas free tier) ────────────────────────────────────
# Sign up at https://www.mongodb.com/cloud/atlas → create free M0 cluster
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/wdd-website?retryWrites=true&w=majority

# ─── NextAuth ──────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-me-with-32+-character-random-secret

# ─── Google OAuth (admin login) ────────────────────────────────────────────
# Create at https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Admin seed ────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@webdigitaldevelopment.in
ADMIN_PASSWORD=ChangeThisStrongPass#2026

# ─── Cloudinary (media storage — free 25GB) ───────────────────────────────
# Sign up at https://cloudinary.com → Dashboard → copy credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Resend (email — free 3000/month) ─────────────────────────────────────
# Sign up at https://resend.com → API Keys → create
RESEND_API_KEY=re_
RESEND_FROM_EMAIL=noreply@webdigitaldevelopment.in

# ─── Upstash Redis (optional — for rate limiting) ─────────────────────────
# Sign up at https://upstash.com → Redis → Create database
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Google Gemini (chatbot) — free tier 15 RPM ────────────────────────────
# Get key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ─── Analytics (optional — public) ─────────────────────────────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_ID=
